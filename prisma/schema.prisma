generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  username      String        @unique
  firstName     String
  lastName      String
  displayName   String
  email         String        @unique
  passwordHash  String
  phoneNumber   String        @default("")
  streetAddress String
  suburb        String?
  townCity      String
  postcode      String
  country       String
  avatarUrl     String?
  backgroundUrl String?
  agreeTerms    Boolean       @default(false)
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Session       Session[]
  Booking       Booking[]
  UserMessage   UserMessage[]
  Message       Message[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Booking {
  id          String           @id @default(uuid())
  fullName    String
  email       String
  mobile      String
  country     String
  package     PackageSelection @default(NONE)
  message     String
  submittedAt DateTime         @default(now())
  status      KavanProcess     @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])
  userId      String

  @@map("bookings")
}

model Message {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  mobile    String
  country   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("messages")
}

model UserMessage {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@map("user_messages")
}

enum UserRole {
  USER
  CUSTOMER
  PROCUSTOMER
  EDITOR
  ADMIN
  SUPERADMIN
}

enum KavanProcess {
  PENDING
  PROCESSING
  REVIEWING
  FINALIZING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PackageSelection {
  NONE
  STARTUPTEAM
  PROFESSIONALTEAM
  ENTERPRISE
}
