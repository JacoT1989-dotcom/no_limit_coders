generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  username          String              @unique
  firstName         String
  lastName          String
  displayName       String
  email             String              @unique
  passwordHash      String
  phoneNumber       String              @default("")
  streetAddress     String
  suburb            String?
  townCity          String
  postcode          String
  country           String
  avatarUrl         String?
  backgroundUrl     String?
  agreeTerms        Boolean             @default(false)
  package           PackageSelection    @default(NONE)
  role              UserRole            @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Session           Session[]
  Booking           Booking[]
  UserMessage       UserMessage[]
  Message           Message[]
  Project           Project[]
  ProjectTeamMember ProjectTeamMember[]
  TaskComment       TaskComment[]
  TaskAttachment    TaskAttachment[]
  ScheduleMeeting   ScheduleMeeting[]
  TechTeamMessage   TechTeamMessage[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

///////////////////////// Public Models ////////////////////////

model Booking {
  id        String           @id @default(uuid())
  fullName  String
  email     String
  mobile    String
  country   String
  package   PackageSelection @default(NONE)
  message   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id])
  userId    String?

  @@map("bookings")
}

model Message {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  mobile    String
  country   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("messages")
}

////////////////////////// USER MODELS /////////////////////////////

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  status           ProjectStatus @default(UNDER_REVIEW)
  priority         Priority      @default(MEDIUM)
  preferredMeeting DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  customer    User                @relation(fields: [customerId], references: [id])
  customerId  String
  tasks       Task[]
  taskColumns TaskColumn[]
  team        ProjectTeamMember[]

  @@map("projects")
}

model ProjectTeamMember {
  id       String   @id @default(uuid())
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  tasks     Task[]

  @@unique([projectId, userId])
  @@map("project_team_members")
}

model TaskColumn {
  id        String      @id @default(uuid())
  name      ColumnState // Changed from String to ColumnState
  order     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  tasks     Task[]

  @@unique([projectId, order])
  @@map("task_columns")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  column      TaskColumn          @relation(fields: [columnId], references: [id])
  columnId    String
  assignees   ProjectTeamMember[]
  parent      Task?               @relation("TaskDependency", fields: [parentId], references: [id])
  parentId    String?
  subtasks    Task[]              @relation("TaskDependency")
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())

  // Relations
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  uploader   User   @relation(fields: [uploaderId], references: [id])
  uploaderId String

  @@map("task_attachments")
}

model ScheduleMeeting {
  id           String   @id @default(uuid())
  subject      String
  date         DateTime
  time         String
  participants String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("schedule_meetings")
}

model TechTeamMessage {
  id          String   @id @default(uuid())
  subject     String
  message     String
  category    String
  messageType String
  priority    Priority
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Attachments
  attachments TechTeamMessageAttachment[]

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // New relation to UserMessage
  userMessage   UserMessage? @relation(fields: [userMessageId], references: [id])
  userMessageId String?      @unique

  @@map("tech_team_messages")
}

model UserMessage {
  id            String          @id @default(uuid())
  sender        String
  subject       String
  preview       String
  category      MessageCategory
  isUnread      Boolean         @default(true)
  hasAttachment Boolean         @default(false)
  createdAt     DateTime        @default(now())

  // Relationships
  user        User                @relation(fields: [userId], references: [id])
  userId      String
  attachments MessageAttachment[]

  // New relationship with TechTeamMessage - one user message can have one tech team response
  techTeamResponse TechTeamMessage?

  @@map("user_messages")
}

model TechTeamMessageAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())

  // Relations
  message   TechTeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  @@map("tech_team_message_attachments")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())

  // Relations
  message   UserMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  @@map("message_attachments")
}

///////////////////////////// ENUS ///////////////////////////////
enum UserRole {
  USER
  CUSTOMER
  PROCUSTOMER
  EDITOR
  ADMIN
  SUPERADMIN
  DEVELOPER
}

enum KavanProcess {
  PENDING
  PROCESSING
  REVIEWING
  FINALIZING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PackageSelection {
  NONE
  STARTUPTEAM
  PROFESSIONALTEAM
  ENTERPRISE
}

enum ProjectStatus {
  UNDER_REVIEW
  ACTIVE
  COMPLETED
  ARCHIVED
  ON_HOLD
}

enum TaskStatus {
  TODO
  REVIEW
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ColumnState {
  TODO
  BACKLOG // this is the review of the task status
  IN_PROGRESS
  DONE // this is the completed of the task status
}

enum MessageCategory {
  DESIGN
  SUPPORT
  MEETING
}
